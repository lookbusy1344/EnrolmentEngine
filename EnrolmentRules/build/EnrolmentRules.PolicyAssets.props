<Project>

    <!--
        The single authoritative declaration of the shipped policy-asset item set: base workflows +
        schema, catalogue/qualification/threshold data + their schemas, the DfE transition matrix, and
        every auxiliary policy under policies/** (currently just policies/elite/, whose own
        workflows/catalogue/thresholds are all it contains — schemas, qualifications and the matrix
        stay single-copy, via OverlayEnrolmentDataSource falling through to the base tree).

        CLI and Web import this file and convert @(EnrolmentPolicyAsset) into Content items with
        CopyToOutputDirectory/CopyToPublishDirectory metadata. The Engine library does not consume
        runtime policy assets; hosts select and supply policy data explicitly.
        Do not add a second direct glob against workflows/, data/, or policies/ in a consuming project
        — adding a file beneath an existing base-data or policy directory must reach every consumer
        from this one file alone. Each item's %(PolicyRelativePath) metadata is the path under the
        shipped layout root (e.g. `workflows\eligibility.yaml`, `policies\elite\data\catalogue.yaml`),
        with platform-native directory separators so it can feed a TargetPath/PackagePath directly.
    -->

    <PropertyGroup>
        <EnrolmentRulesRepoRoot>$(MSBuildThisFileDirectory)..\</EnrolmentRulesRepoRoot>
    </PropertyGroup>

    <ItemGroup>
        <EnrolmentPolicyAsset Include="$(EnrolmentRulesRepoRoot)workflows\**\*">
            <PolicyRelativePath>workflows/%(RecursiveDir)%(Filename)%(Extension)</PolicyRelativePath>
        </EnrolmentPolicyAsset>

        <EnrolmentPolicyAsset Include="
            $(EnrolmentRulesRepoRoot)data\catalogue.yaml;
            $(EnrolmentRulesRepoRoot)data\catalogue.schema.json;
            $(EnrolmentRulesRepoRoot)data\qualifications.yaml;
            $(EnrolmentRulesRepoRoot)data\qualifications.schema.json;
            $(EnrolmentRulesRepoRoot)data\thresholds.yaml;
            $(EnrolmentRulesRepoRoot)data\thresholds.schema.json">
            <PolicyRelativePath>data/%(Filename)%(Extension)</PolicyRelativePath>
        </EnrolmentPolicyAsset>

        <EnrolmentPolicyAsset Include="$(EnrolmentRulesRepoRoot)data\dfe-transition-matrices\**\*">
            <PolicyRelativePath>data/dfe-transition-matrices/%(RecursiveDir)%(Filename)%(Extension)</PolicyRelativePath>
        </EnrolmentPolicyAsset>

        <EnrolmentPolicyAsset Include="$(EnrolmentRulesRepoRoot)policies\**\*">
            <PolicyRelativePath>policies/%(RecursiveDir)%(Filename)%(Extension)</PolicyRelativePath>
        </EnrolmentPolicyAsset>
    </ItemGroup>

</Project>
