<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\EnrolmentRules.Domain\EnrolmentRules.Domain.csproj"/>
        <ProjectReference Include="..\EnrolmentRules.Prediction\EnrolmentRules.Prediction.csproj"/>
        <ProjectReference Include="..\EnrolmentRules.Engine\EnrolmentRules.Engine.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- PrivateAssets stops BenchmarkDotNet's own Roslyn dependency (used for its generated benchmark
             runners) from flowing transitively into EnrolmentRules.Tests, which references this project
             only so CodeStyle_StructSize can Assembly.Load it, and pins a different Microsoft.CodeAnalysis
             version for Razor parsing. -->
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>
