<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>EnrolmentRules.Extensions.DependencyInjection</PackageId>
        <Description>Dependency-injection registration extensions for EnrolmentRules hosts.</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- GenerateDocumentationFile ships XML docs for package consumers. CS1591 (missing doc on a
             public member) is suppressed because most of the public surface is value-equality
             boilerplate, enum-like members, and types forced CLR-public only for RulesEngine lambda
             binding, source generation, or collection expressions. Those types are still exported
             contracts (see the API specification's "Exported runtime support" section), just not
             mainline consumer entry points; blanket enforcement would generate filler, not value.
             Genuine entry points are documented by hand. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\EnrolmentRules.Engine\EnrolmentRules.Engine.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11"/>
    </ItemGroup>

</Project>
