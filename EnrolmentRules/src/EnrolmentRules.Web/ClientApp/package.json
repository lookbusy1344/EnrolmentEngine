{
  "name": "clientapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:no-js-source": "node scripts/check-no-js-source.mjs",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "build": "vue-tsc -b && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "e2e": "playwright test",
    "verify:checks": "pnpm lint && pnpm check:no-js-source && pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm format:check && pnpm verify:checks"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
