@* @formatter:off *@
@* Rider's Razor formatter corrupts this file on reformat: it silently deletes tokens (e.g. turns
   "Model.DateOfBirth?.ToString(...)" into "Model.?.ToString(...)"), not just realigns them. Looks
   like a Rider bug. Leave formatting off here until it's fixed upstream. *@
@page "/razor"
@using System.Globalization
@using EnrolmentRules.Web.Models
@model RazorModel
@{
	ViewData["Title"] = "Enrolment · server rendered";
}

@{
	var otherPolicy = Model.AvailablePolicies.FirstOrDefault(p => p.Id != Model.SelectedPolicy.Id);
	var availableChoiceCount = Model.Basket.Count(entry => entry.Status == ChoiceStatus.Available);
	var maxChoices = Model.Results?.Comparison?.MaxChosenALevels;
	var exceedsChoiceLimit = maxChoices is int limit && availableChoiceCount > limit;
}

<!--
	razor-sync.ts reads the three items below on load: the just-rendered snapshot (kept in sync
	with the same localStorage key/shape /app owns), and enough context (data-empty/data-cleared)
	to tell a true cold visit — worth rehydrating from localStorage — apart from an explicit
	"Start over", which should clear localStorage instead. #hydrate-form is submitted only by that
	script, never by a visible control; the tag helper still gives it a real antiforgery token.
-->
<script type="application/json" id="enrolment-snapshot">@Html.Raw(Model.SnapshotJson)</script>
<div id="enrolment-sync-flags" hidden data-selected-policy="@Model.SelectedPolicy.Id.Value"
     data-empty="@(Model.IsSnapshotEmpty ? "true" : "false")" data-cleared="@(Model.JustCleared ? "true" : "false")"></div>
<form id="hydrate-form" method="post" asp-page-handler="Hydrate" hidden></form>
@foreach (var stylesheet in Model.SyncScriptAssets.StylesheetPaths) {
	<link rel="stylesheet" href="@stylesheet"/>
}
<script type="module" src="@Model.SyncScriptAssets.ScriptPath"></script>

<section class="hero" aria-labelledby="hero-heading">
	<p class="hero-eyebrow">GCSEs in → A-Levels out
		<span class="mode-tag pill pill--active">Server rendered</span>
		<a class="mode-switch pill pill--link" href="/app?policy=@Model.SelectedPolicy.Id.Value">Dynamic version</a>
		<span class="policy-switch" aria-label="Selected enrolment policy">
			<strong class="pill pill--active">@Model.SelectedPolicy.DisplayName</strong>
			@if (otherPolicy is not null) {
				<a class="pill pill--link" href="/razor?policy=@otherPolicy.Id.Value">Switch to @otherPolicy.DisplayName</a>
			}
		</span>
	</p>
	<h1 id="hero-heading">See how your skills can <span class="grow">grow</span>.</h1>
	<p class="hero-lede">Add your grades and interests. We'll show which A-Levels are wide open, worth a look, or not a fit yet — so you can plant the
		right next step. A demo built on the <a href="https://github.com/lookbusy1344/EnrolmentEngine/tree/main/EnrolmentRules" target="_blank"
		                                        rel="noopener noreferrer">enrolment engine</a>.</p>
	<svg class="sprout d-none d-sm-block" viewBox="0 0 120 140" aria-hidden="true" focusable="false">
		<path class="soil" d="M18 120h84" fill="none" stroke-width="2.5" stroke-linecap="round"/>
		<path class="stem" d="M60 122V54" fill="none" stroke-width="4" stroke-linecap="round"/>
		<path class="leaf-a" d="M60 78C60 58 40 46 14 50c0 20 20 34 46 28Z"/>
		<path class="leaf-b" d="M60 66C60 42 82 28 108 34c0 22-22 38-48 32Z"/>
		<path class="leaf-c" d="M60 54c-6-14 2-30 16-34 6 14-2 30-16 34Z"/>
	</svg>
</section>

<section
	class="chosen-summary sticky-top bg-body border-bottom py-2 mb-4 @(exceedsChoiceLimit ? "bg-danger-subtle border border-danger rounded px-3" : null)"
	aria-labelledby="chosen-heading">
	<div class="d-flex align-items-baseline justify-content-between gap-3 flex-wrap mb-2">
		<h2 id="chosen-heading" class="h5 mb-0">Your basket</h2>
		@if (Model.Scoreboard.Count > 0) {
			<dl id="gcse-scoreboard" class="d-flex gap-3 mb-0 small" aria-label="GCSE scoreboard">
				<div>
					<dt class="d-inline text-body-secondary">GCSEs</dt>
					<dd class="d-inline fw-bold ms-1 text-success" data-testid="scoreboard-count">@Model.Scoreboard.Count</dd>
				</div>
				<div>
					<dt class="d-inline text-body-secondary">Pts</dt>
					<dd class="d-inline fw-bold ms-1 text-success" data-testid="scoreboard-total">@Model.Scoreboard.Total</dd>
				</div>
				<div>
					<dt class="d-inline text-body-secondary">Avg</dt>
					<dd class="d-inline fw-bold ms-1 text-success" data-testid="scoreboard-average">@Model.Scoreboard.Average.ToString("0.0", CultureInfo.InvariantCulture)</dd>
				</div>
			</dl>
		}
	</div>
	@if (Model.Basket.Count == 0) {
		<p class="mb-0 text-body-secondary">None chosen yet.</p>
	} else {
		<div class="d-flex justify-content-between align-items-start gap-2">
			<ul class="list-inline mb-0">
				@* An amber choice keeps its amber pill and carries the word "Borderline"; an unavailable (red) or
				   not-offered choice keeps its own status tag instead of being ejected — the flag survives for
				   anyone who cannot use the colour, and switching policies never silently drops a selection. *@
				@foreach (var entry in Model.Basket) {
					var subjectLabel = TextFormatting.Prettify(entry.Subject.Value);
					<li class="list-inline-item badge @entry.CssClass rounded-pill">@subjectLabel
						@if (entry.IsBorderline) {
							<span class="basket-borderline-tag"> - Borderline</span>
						} else if (entry.Status == ChoiceStatus.Unavailable) {
							<span class="basket-status-tag"> - Unavailable</span>
						} else if (entry.Status == ChoiceStatus.NotOffered) {
							<span class="basket-status-tag"> - Not offered by @Model.SelectedPolicy.DisplayName</span>
						}
						<form method="post" asp-page-handler="RemoveSubject" class="d-inline">
							<input type="hidden" name="subject" value="@entry.Subject.Value"/>
							<button type="submit" class="basket-remove" aria-label="Remove @subjectLabel"><span aria-hidden="true">&times;</span></button>
						</form>
					</li>
				}
			</ul>
			<details class="basket-empty flex-shrink-0">
				<summary id="basket-empty" class="btn btn-sm btn-outline-danger basket-empty-btn basket-empty-toggle">
					<svg class="basket-empty-icon basket-empty-icon-bin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
						<path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
						<path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
					</svg>
					<svg class="basket-empty-icon basket-empty-icon-cross" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
						<path d="M2.146 2.146a.5.5 0 0 1 .708 0L8 7.293l5.146-5.147a.5.5 0 1 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854a.5.5 0 0 1 0-.708"/>
					</svg>
					@* summary text is its accessible name; it swaps with the icon so the label reads "Empty basket" closed, "Cancel" open. *@
					<span class="visually-hidden basket-empty-label-bin">Empty basket</span>
					<span class="visually-hidden basket-empty-label-cross">Cancel</span>
				</summary>
				<div id="basket-empty-confirm" class="basket-empty-confirm">
					<form method="post" asp-page-handler="EmptyBasket" class="d-inline">
						<button type="submit" class="btn btn-sm btn-danger basket-empty-btn" aria-label="Confirm empty basket" title="Confirm empty basket">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
								<path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0"/>
							</svg>
						</button>
					</form>
				</div>
			</details>
		</div>
		@if (Model.HasBorderlineChoices) {
			<p id="borderline-notice" class="mb-0 mt-2 small text-body-secondary">
				Borderline choices stay in your basket, but need additional authorisation before you can enrol on them.
			</p>
		}
		@if (exceedsChoiceLimit) {
			<p id="basket-choice-limit-error" class="alert alert-danger mb-0 mt-2 py-2" role="alert">
				Too many subjects chosen: this policy allows at most @maxChoices, but your basket contains @availableChoiceCount. Remove a choice.
			</p>
		}
	}
</section>

<!-- novalidate: other submit buttons opt out individually with formnovalidate; kept here too so a
     future required/pattern field doesn't silently start blocking the main submit. -->
<form method="post" asp-page-handler="SaveFacts" class="facts-form mb-4" novalidate>
	<section aria-labelledby="facts-heading">
		<span class="section-eyebrow">Step 1</span>
		<h2 id="facts-heading">About you</h2>

		<div class="mb-3 date-field">
			<label for="DateOfBirth" class="form-label">Date of birth</label>
			<!-- IndexModel pre-fills this with a plausible date (not a real fact yet, just a display
			     default) rather than leaving it empty: Safari renders an empty native date input's
			     "today's date" hint in a dimmed shade CSS cannot override (WebKit doesn't expose the
			     ::-webkit-datetime-edit-* internals the way Chromium does). -->
			<div class="d-flex align-items-center gap-2 flex-nowrap">
				<input type="date" id="DateOfBirth" name="DateOfBirth" class="form-control w-auto flex-shrink-0"
				       value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))"/>
				<span id="DateOfBirthAge" class="form-text mb-0 text-nowrap">Age: @Model.Age</span>
				<!-- Any save round-trip already recalculates the age against the current field value, so
				     this button is a convenience for an instant recheck, not a requirement. -->
				<button type="submit" formaction="?handler=SaveFacts&amp;fragment=facts-heading" formmethod="post" formnovalidate
				        class="btn btn-sm btn-outline-secondary text-nowrap">Update age
				</button>
			</div>
		</div>

		<fieldset id="gcse-section" class="border rounded p-3 mb-3">
			<legend class="h6">GCSEs</legend>
			@for (var i = 0; i < Model.Gcses.Count; ++i) {
				<div class="row g-2 mb-2 align-items-end">
					<div class="col-12 col-md-3">
						<label for="Gcses_@(i)__Subject" class="form-label">Subject</label>
						<select id="Gcses_@(i)__Subject" name="Gcses[@i].Subject" class="form-select">
							<option value="">-- select --</option>
							@foreach (var subjectKey in Model.GcseSubjectOptions) {
								if (!Model.IsGcseSubjectChosenElsewhere(i, subjectKey)) {
									<option value="@subjectKey"
									        selected="@(Model.Gcses[i].Subject == subjectKey)">@TextFormatting.Prettify(subjectKey)</option>
								}
							}
						</select>
					</div>
					<div class="col-12 col-md-auto">
						<span class="form-label d-block" id="Gcses_@(i)__GradeLabel">Grade</span>
						<!-- Grade is a discrete 1-9 scale, not a free-typed number: a toggle-button group is a
						     single click, is unambiguous on a phone keypad, and cannot carry an out-of-range or
						     decimal value the server would otherwise have to normalise (Thresholds.NormalizeGcseGrade
						     still runs, but only ever sees an unset or exact 1-9 value from this control). -->
						<div class="btn-group btn-group-sm flex-wrap gcse-grade-picker" role="group" aria-labelledby="Gcses_@(i)__GradeLabel">
							@for (var grade = 1; grade <= 9; ++grade) {
								<input type="radio" class="btn-check" name="Gcses[@i].Grade" id="Gcses_@(i)__Grade_@grade" value="@grade"
								       autocomplete="off" checked="@(Model.Gcses[i].Grade == grade)"/>
								<label class="btn btn-outline-primary" for="Gcses_@(i)__Grade_@grade">@grade</label>
							}
						</div>
					</div>
					@if (!Model.Gcses[i].ToRow().IsEmpty) {
						<div class="col-12 col-md-auto">
							<button type="submit" formaction="?handler=RemoveGcseRow&amp;index=@i" formmethod="post" formnovalidate
							        class="btn btn-sm btn-outline-danger">Remove
							</button>
						</div>
					}
				</div>
			}
			<button type="submit" formaction="?handler=SaveFacts&amp;fragment=gcse-section" formmethod="post" formnovalidate
			        class="btn btn-sm btn-outline-primary">Add
			</button>
		</fieldset>

		<fieldset id="qualifications-section" class="border rounded p-3 mb-3">
			<legend class="h6">Other qualifications</legend>
			@for (var i = 0; i < Model.PriorQualifications.Count; ++i) {
				var row = Model.PriorQualifications[i];
				<div class="row g-2 mb-2 align-items-end">
					<div class="col-sm-6">
						<label for="PriorQualifications_@(i)__Subject" class="form-label">Subject</label>
						<select id="PriorQualifications_@(i)__Subject" name="PriorQualifications[@i].Subject"
						        class="form-select prior-qualification-subject">
							<option value="">-- select --</option>
							@foreach (var group in Model.PriorQualificationSubjectGroups) {
								<optgroup label="@group.Label" data-type="@group.Type">
									@foreach (var subjectKey in group.Subjects) {
										<option value="@subjectKey"
										        selected="@(row.Subject == subjectKey)">@TextFormatting.Prettify(subjectKey)</option>
									}
								</optgroup>
							}
						</select>
						<input type="hidden" id="PriorQualifications_@(i)__Type" name="PriorQualifications[@i].Type" value="@row.Type"
						       class="prior-qualification-type"/>
					</div>
					<div class="col-sm-4">
						<label for="PriorQualifications_@(i)__Grade" class="form-label">Grade</label>
						<select id="PriorQualifications_@(i)__Grade" name="PriorQualifications[@i].Grade"
						        class="form-select prior-qualification-grade">
							<option value="">-- select --</option>
							@if (row.Type is QualificationType selectedType) {
								@foreach (var grade in Model.QualificationGradeOptions[selectedType]) {
									<option value="@grade" selected="@(row.Grade == grade)">@TextFormatting.GradeLabel(selectedType, grade)</option>
								}
							}
						</select>
					</div>
					@if (!row.ToRow().IsEmpty) {
						<div class="col-sm-2">
							<button type="submit" formaction="?handler=RemoveQualificationRow&amp;index=@i" formmethod="post" formnovalidate
							        class="btn btn-sm btn-outline-danger">Remove
							</button>
						</div>
					}
				</div>
			}
			<button type="submit" formaction="?handler=SaveFacts&amp;fragment=qualifications-section" formmethod="post" formnovalidate
			        class="btn btn-sm btn-outline-primary">Add
			</button>
		</fieldset>

		<script type="application/json" id="qualification-grade-options">@Html.Raw(Model.QualificationGradeOptionsJson)</script>
		<script>
			(function () {
				var gradeOptionsByType = JSON.parse(document.getElementById("qualification-grade-options").textContent)
					.reduce(function (byType, entry) {
						byType[entry.type] = entry.grades;
						return byType;
					}, {});

				function populateGradeOptions(gradeSelect, type) {
					var grades = gradeOptionsByType[type] || [];
					gradeSelect.replaceChildren();
					var placeholder = document.createElement("option");
					placeholder.value = "";
					placeholder.textContent = "-- select --";
					gradeSelect.append(placeholder);
					grades.forEach(function (grade) {
						var option = document.createElement("option");
						option.value = grade.value;
						option.textContent = grade.label;
						gradeSelect.append(option);
					});
				}

				document.getElementById("qualifications-section").addEventListener("change", function (event) {
					var subjectSelect = event.target;
					if (!subjectSelect.classList.contains("prior-qualification-subject")) {
						return;
					}

					var selectedOption = subjectSelect.options[subjectSelect.selectedIndex];
					var type = selectedOption && selectedOption.parentElement instanceof HTMLOptGroupElement
						? selectedOption.parentElement.dataset.type
						: "";

					var row = subjectSelect.closest(".row");
					row.querySelector(".prior-qualification-type").value = type;
					populateGradeOptions(row.querySelector(".prior-qualification-grade"), type);
				});
			})();
		</script>

		<fieldset id="hobbies-section" class="border rounded p-3 mb-3">
			<legend class="h6">Hobbies</legend>
			@for (var i = 0; i < Model.Hobbies.Count; ++i) {
				<div class="row g-2 mb-2 align-items-end">
					<div class="col-sm-6">
						<label for="Hobbies_@(i)_" class="form-label">Hobby</label>
						<select id="Hobbies_@(i)_" name="Hobbies[@i]" class="form-select">
							<option value="">-- select --</option>
							@foreach (var hobby in Model.HobbyOptions) {
								<option value="@hobby" selected="@(Model.Hobbies[i] == hobby)">@TextFormatting.Prettify(hobby)</option>
							}
						</select>
					</div>
					@if (!string.IsNullOrWhiteSpace(Model.Hobbies[i])) {
						<div class="col-sm-3">
							<button type="submit" formaction="?handler=RemoveHobbyRow&amp;index=@i" formmethod="post" formnovalidate
							        class="btn btn-sm btn-outline-danger">Remove
							</button>
						</div>
					}
				</div>
			}
			<button type="submit" formaction="?handler=SaveFacts&amp;fragment=hobbies-section" formmethod="post" formnovalidate
			        class="btn btn-sm btn-outline-primary">Add
			</button>
		</fieldset>
	</section>
	<button type="submit" class="btn btn-primary">Save &amp; see options</button>
</form>

<form method="post" asp-page-handler="Reset" class="mb-4">
	<button type="submit" class="btn btn-outline-secondary">Start over</button>
</form>

<section aria-labelledby="results-heading">
	<span class="section-eyebrow">Step 2</span>
	<h2 id="results-heading">What's open to you</h2>
	@if (Model.Results is not EnrolmentResultsViewModel results) {
		<p>Add a GCSE, a prior qualification or your date of birth, then save — your options sprout up here.</p>
	} else if (!results.IsValid) {
		<div class="alert alert-danger" role="alert">
			<ul class="mb-0">
				@foreach (var error in results.ValidationErrors) {
					<li>@error</li>
				}
			</ul>
		</div>
	} else if (!results.Comparison!.Explanation.Eligible) {
		<div class="alert alert-danger" role="alert">
			<p class="fw-bold">Not eligible.</p>
			<ul class="mb-0">
				@foreach (var reason in results.Comparison.Explanation.EligibilityReasons) {
					<li>@reason</li>
				}
			</ul>
		</div>
	} else {
		var choiceLimitReason = results.Comparison.Explanation.Explanations
			                               .SelectMany(e => e.Overrides)
			                               .FirstOrDefault(a => a.Kind == AdjustmentKind.ChosenSubjectCap)?.Reason;
		if (choiceLimitReason is not null) {
			<div id="choice-limit-notice" class="alert alert-info" role="status">
				<p class="fw-bold mb-1">Choice limit reached.</p>
				<p class="mb-0">@choiceLimitReason</p>
			</div>
		}

		<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
			@foreach (var explanation in RatingDisplay.OrderForCards(results.Comparison.Explanation.Explanations)) {
				var chosen = Model.ChosenALevels.Contains(explanation.Subject);
				var canChoose = explanation.Rating != Rating.Red;
				var reasonId = $"reason-{explanation.Subject.Value}";
				<div class="col">
					<article class="card h-100">
						<div class="card-body">
							<h3 class="card-title h6 d-flex justify-content-between align-items-center">
								@TextFormatting.Prettify(explanation.Subject.Value)
								<span class="badge @RatingDisplay.CssClass(explanation.Rating)"><span
										class="visually-hidden">Rating: </span>@explanation.Rating</span>
							</h3>
							<p id="@reasonId" class="card-text">@explanation.Reason</p>
							<details>
								<summary>Details</summary>
								<dl class="mb-0">
									<dt>Base rating</dt>
									<dd>@explanation.BaseRating (@explanation.BaseReason)</dd>
									<dt>Rule</dt>
									<dd>@explanation.Rule</dd>
									<dt>Predicted points</dt>
									<dd>@explanation.PredictedPoints.ToString("0.00")</dd>
									@if (explanation.EntryEquivalentReason is string entryReason) {
										<dt>Entry equivalence</dt>
										<dd>@entryReason</dd>
									}
									@if (explanation.Overrides.Count > 0) {
										<dt>Overrides</dt>
										<dd>
											<ul class="mb-0">
												@foreach (var adjustment in explanation.Overrides) {
													<li>@adjustment.From → @adjustment.To: @adjustment.Reason</li>
												}
											</ul>
										</dd>
									}
								</dl>
							</details>
							@if (chosen) {
								<form method="post" asp-page-handler="RemoveSubject" class="mt-2">
									<input type="hidden" name="subject" value="@explanation.Subject.Value"/>
									<button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
								</form>
							} else if (canChoose) {
								<form method="post" asp-page-handler="ChooseSubject" class="mt-2">
									<input type="hidden" name="subject" value="@explanation.Subject.Value"/>
									<button type="submit" class="btn btn-sm btn-outline-primary">Choose</button>
								</form>
							} else {
								<button type="button" class="btn btn-sm btn-outline-secondary mt-2" disabled aria-describedby="@reasonId">
									Unavailable
								</button>
							}
						</div>
					</article>
				</div>
			}
		</div>
	}
</section>
